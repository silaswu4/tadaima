# Unique secret seed. It derives the agent address; anyone with it can impersonate the agent.
AGENT_SEED=
# The exact backend holding the browser room session (this Mac's local preview)
BACKEND_URL=http://127.0.0.1:3017
# Vercel deployment protection bypass secret (ask Matthew). Leave empty for localhost.
VERCEL_PROTECTION_BYPASS=
AGENT_NAME=tadaima
AGENT_PORT=8001
# Python tool-selection brain (backend planner/research keys also belong in the website's .env.local)
ANTHROPIC_API_KEY=
# Optional shared key only for legacy account routes; does not authorize private scanned rooms
AGENT_API_KEY=
# Default 0: pair an existing scanned room instead of legacy account onboarding
FETCH_ENABLE_LEGACY_ONBOARDING=0
# Optional legacy public demo images / test checkout. Not used for paired rooms.
PUBLIC_URL=
VIZ_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
AGENTVERSE_API_KEY=

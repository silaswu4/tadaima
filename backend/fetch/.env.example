# Unique secret seed. It derives the agent address; anyone with it can impersonate the agent.
AGENT_SEED=
# Tadaima backend (deployed production domain, or http://localhost:3000)
BACKEND_URL=
# Public https base for room images (defaults to BACKEND_URL); ASI:One fetches images itself
PUBLIC_URL=
# Shared with the backend: guards /api/agent/* and signs /api/viz images
AGENT_API_KEY=
VIZ_SECRET=
# Vercel deployment protection bypass for server-to-server calls (never in image URLs)
VERCEL_PROTECTION_BYPASS=
ANTHROPIC_API_KEY=
# Stripe TEST keys only (sk_test_ or rk_test_, pk_test_)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
AGENTVERSE_API_KEY=
AGENT_NAME=tadaima
AGENT_PORT=8001
